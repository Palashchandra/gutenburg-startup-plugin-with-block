{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "pctheme/feature-grid",
  "title": "Feature Grid",
  "category": "pctheme",
  "icon": "grid-view",
  "description": "A grid of features with icons",
  "keywords": ["features", "grid", "services"],
  "textdomain": "pctheme-blocks",
  "attributes": {
    "features": {
      "type": "array",
      "default": [
        {
          "title": "Fast Performance",
          "description": "Lightning fast loading speeds",
          "icon": "⚡"
        },
        {
          "title": "Responsive Design",
          "description": "Works on all devices",
          "icon": "📱"
        },
        {
          "title": "Easy to Use",
          "description": "Simple and intuitive interface",
          "icon": "✨"
        }
      ]
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "example": {
    "attributes": {
      "features": [
        {
          "title": "Fast Performance",
          "description": "Lightning fast loading speeds",
          "icon": "⚡"
        },
        {
          "title": "Responsive Design",
          "description": "Works on all devices",
          "icon": "📱"
        },
        {
          "title": "Easy to Use",
          "description": "Simple and intuitive interface",
          "icon": "✨"
        }
      ]
    }
  },
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}