{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "pctheme/hero",
  "title": "Hero Section",
  "category": "pctheme",
  "icon": "cover-image",
  "description": "A hero section with title, description and button",
  "keywords": ["hero", "banner", "header"],
  "textdomain": "pctheme-blocks",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Welcome to Our Website"
    },
    "description": {
      "type": "string",
      "default": "Create amazing experiences with Tailwind CSS"
    },
    "buttonText": {
      "type": "string",
      "default": "Get Started"
    },
    "buttonUrl": {
      "type": "string",
      "default": "#"
    },
    "backgroundColor": {
      "type": "string",
      "default": "blue"
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}